{
  "name": "@nexlet/website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp -C . dev --host 127.0.0.1",
    "build": "vp -C . build",
    "start": "vp -C . preview --host 127.0.0.1",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "test:run": "vp test run",
    "test:browser": "node scripts/browser-tests.mjs",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "^26.4.4",
    "lucide-react": "1.33.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^17.0.16",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "30.0.1",
    "playwright": "1.64.0",
    "tailwindcss": "4.2.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3",
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.11.2"
}
