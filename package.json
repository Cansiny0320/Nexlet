{
  "name": "nexlet",
  "version": "0.2.40",
  "private": true,
  "description": "Nexlet 跨平台桌面工具箱",
  "homepage": "https://github.com/Cansiny0320/Nexlet",
  "license": "MIT",
  "author": "Nexlet",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "pnpm build && electron .",
    "dev": "pnpm start",
    "lint": "vp lint --max-warnings 0",
    "lint:fix": "vp lint --fix --max-warnings 0",
    "typecheck": "vp check --no-fmt --no-lint",
    "check": "vp check",
    "test": "vp test run",
    "test:e2e": "pnpm build && playwright test",
    "package:win": "pnpm build && node scripts/package-windows.mjs",
    "package:mac": "node scripts/package-mac-local.mjs --arch universal",
    "package:mac:local": "node scripts/package-mac-local.mjs",
    "generate:mac-dmg": "node scripts/generate-mac-dmg-background.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:portable": "node scripts/smoke-portable.mjs",
    "package:linux": "pnpm build && node scripts/package-linux.mjs",
    "format": "vp fmt",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "@orpc/client": "1.15.7",
    "@orpc/server": "1.15.7",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "decimal.js": "^10.6.0",
    "electron-updater": "6.8.10",
    "i18next": "^26.4.5",
    "jsonc-parser": "^3.3.1",
    "koffi": "^3.3.3",
    "pinyin-pro": "^3.29.5",
    "semver": "^7.8.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/merge": "^6.12.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "4.3.2",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.1.0-beta",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "build": {
    "appId": "app.nexlet.desktop",
    "productName": "Nexlet",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!assets/artwork/**/*",
      "!**/*.map",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "assets/vendor/everything/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Nexlet-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "electronLanguages": [
        "en",
        "zh_CN",
        "zh_TW"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Nexlet-${version}-macOS-${arch}.${ext}"
    },
    "dmg": {
      "background": "build-resources/mac/background.png",
      "window": {
        "width": 680,
        "height": 520
      },
      "iconSize": 96,
      "iconTextSize": 14,
      "contents": [
        {
          "x": 180,
          "y": 170,
          "type": "file"
        },
        {
          "x": 500,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cansiny0320",
        "repo": "Nexlet",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "include": "assets/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Nexlet-${version}-Windows-${arch}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "nexlet",
      "syncDesktopName": true,
      "maintainer": "Nexlet <noreply@users.noreply.github.com>",
      "artifactName": "Nexlet-${version}-Linux-${arch}.${ext}",
      "files": [
        "!assets/vendor/everything/**/*"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "app.nexlet.desktop"
        }
      }
    },
    "deb": {
      "recommends": [
        "xdotool",
        "fonts-noto-cjk"
      ],
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libasound2",
        "libgbm1",
        "libnotify4",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libglib2.0-bin",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "desktopName": "app.nexlet.desktop.desktop"
}
