{
  "name": "nexlet",
  "version": "0.2.26",
  "private": true,
  "description": "Nexlet 跨平台桌面工具箱",
  "author": "Nexlet",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && playwright test",
    "package:win": "npm run build && electron-builder --win portable nsis --x64 --publish never",
    "package:mac": "node scripts/package-mac-local.mjs --arch universal",
    "package:mac:local": "node scripts/package-mac-local.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:portable": "node scripts/smoke-portable.mjs",
    "package:linux": "npm run build && node scripts/package-linux.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/merge": "^6.12.2",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "decimal.js": "^10.6.0",
    "electron-updater": "6.8.10",
    "ffmpeg-static": "^5.3.0",
    "i18next": "^26.4.5",
    "jsonc-parser": "^3.3.1",
    "koffi": "^3.3.3",
    "lucide-react": "^0.468.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@paddleocr/paddleocr-js": "0.4.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "js-yaml": "4.3.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "app.nexlet.desktop",
    "productName": "Nexlet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "!assets/artwork/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "assets/vendor/everything/**/*",
      "assets/vendor/ocr/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "Nexlet-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Nexlet-${version}-macOS-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Cansiny0320",
        "repo": "Nexlet",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "include": "assets/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Nexlet-${version}-Windows-${arch}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "nexlet",
      "syncDesktopName": true,
      "maintainer": "Nexlet <noreply@users.noreply.github.com>",
      "artifactName": "Nexlet-${version}-Linux-${arch}.${ext}",
      "files": [
        "!assets/vendor/everything/**/*"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "app.nexlet.desktop"
        }
      }
    },
    "deb": {
      "recommends": [
        "xdotool",
        "fonts-noto-cjk"
      ],
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libasound2",
        "libgbm1",
        "libnotify4",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libglib2.0-bin",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "desktopName": "app.nexlet.desktop.desktop",
  "homepage": "https://github.com/Cansiny0320/Nexlet"
}
