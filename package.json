{
  "name": "nexlet",
  "version": "0.2.2",
  "private": true,
  "description": "Nexlet 跨平台桌面工具箱",
  "author": "Nexlet",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && playwright test",
    "package:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --universal --publish never",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:portable": "node scripts/smoke-portable.mjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/merge": "^6.12.2",
    "adm-zip": "^0.6.1",
    "codemirror": "^6.0.2",
    "decimal.js": "^10.6.0",
    "jsonc-parser": "^3.3.1",
    "koffi": "^3.3.3",
    "lucide-react": "^0.468.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "app.nexlet.desktop",
    "productName": "Nexlet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "assets/vendor/everything/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "Nexlet-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Nexlet-${version}-macOS-${arch}.${ext}"
    }
  }
}
